{
  "name": "gudfun",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "lint": "bun --cwd packages/web run lint",
    "typecheck": "bun --cwd packages/web run typecheck && bun --cwd packages/api run typecheck && bun --cwd packages/database run typecheck",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose -f packages/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f packages/docker/docker-compose.yml down",
    "zero:schema": "drizzle-zero generate --format --schema ./packages/database/src/schemas/index.ts --output ./packages/zero/src/zero-schema.gen.ts --tsconfig ./packages/database/tsconfig.json",
    "zero:dev": "ZERO_QUERY_FORWARD_COOKIES=true ZERO_MUTATE_FORWARD_COOKIES=true bun --env-file=./zero.env run bunx zero-cache-dev --schema-path=./packages/zero/src/zero-schema.gen.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "dependencies": {
    "drizzle-zero": "1.0.0-beta.1"
  }
}
